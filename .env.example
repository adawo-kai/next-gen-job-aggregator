# Copy to .env. Everything is optional for local development (demo data + rules engine).
# Production: see docs/DEPLOY.md — DOMAIN, JWT_SECRET, POSTGRES_PASSWORD, GRAFANA_PASSWORD are required there.

# Telegram bot + Mini App
TELEGRAM_BOT_TOKEN=            # from @BotFather; enables the bot, notifications and Mini App sign-in
TELEGRAM_BOT_USERNAME=NextGenJobAgr_bot
WEBAPP_URL=                    # public HTTPS origin; Mini App = $WEBAPP_URL/tg (prod: https://$DOMAIN)

# Security
JWT_SECRET=change-me           # prod: openssl rand -hex 32 (API refuses to start with a weak one)
REAL_IP_HEADER=                # behind a Cloudflare tunnel: cf-connecting-ip

# Sources
HH_ACCESS_TOKEN=               # hh.ru app token (dev.hh.ru); without it hh is skipped
TELEGRAM_CHANNELS=             # comma separated; a vetted default list is built in

# E-mail (password reset). Any provider's free SMTP works: Brevo, Resend, Mailjet, Yandex 360…
SMTP_URL=                      # smtps://user:password@smtp.host:465  or  smtp://user:password@host:587
MAIL_FROM=JobRadar <noreply@example.com>
PUBLIC_URL=http://localhost:3000

# Monitoring / analytics (optional)
SENTRY_DSN=                    # backend errors
SENTRY_DSN_WEB=                # frontend errors (build arg in prod)
YM_ID=                         # Yandex Metrika counter id (build arg in prod)

# LLM enrichment (optional; rules engine otherwise)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
