# Copy to .env. Everything is optional — the project runs fully offline without keys.
TELEGRAM_BOT_TOKEN=            # from @BotFather; enables notifications bot
TELEGRAM_BOT_USERNAME=nextgen_jobs_bot
JWT_SECRET=change-me
ANTHROPIC_API_KEY=             # enables LLM enrichment; otherwise rules engine is used
LLM_MODEL=claude-haiku-5-5
HH_ACCESS_TOKEN=               # hh.ru now requires an app token for /vacancies
TELEGRAM_CHANNELS=             # comma separated; defaults are built in
